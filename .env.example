# Neon → seu projeto → Connect → marque "Connection pooling" e copie a URL
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Texto aleatório com 32+ caracteres (ex.: `openssl rand -base64 48`)
JWT_SECRET=troque-por-um-texto-aleatorio-bem-longo-com-mais-de-32-caracteres
